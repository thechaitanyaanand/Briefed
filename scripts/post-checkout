#!/bin/sh
# BRIEFED_HOOK
# Branch switches only ($3 = 1), and only when HEAD actually moved
[ "$3" = "1" ] && [ "$1" != "$2" ] || exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
# Project-pinned version first, so a stale global install can't override it
if [ -x ./node_modules/.bin/briefed ]; then b=./node_modules/.bin/briefed
elif command -v briefed >/dev/null 2>&1; then b=briefed
else b="npx --yes --package=briefed-cli briefed"; fi
# Background so git returns immediately; last run's output lands in .git/briefed.log
($b run --since "$1" >"$(git rev-parse --git-path briefed.log)" 2>&1 &)
exit 0
